# Public client configuration (safe to expose in the browser). Copy to .env.local for local development.
# On GitHub Pages set the same names as repository *variables* (Settings > Secrets and variables > Actions > Variables).
# NEVER put the Supabase service_role key or any other secret here: everything in a VITE_ variable ends up in the shipped JavaScript.

# Supabase project URL, e.g. https://abcdefghijklmnop.supabase.co
VITE_SUPABASE_URL=
# Supabase publishable key (formerly "anon" key). Row Level Security protects the data, so this key is meant to be public.
VITE_SUPABASE_ANON_KEY=

# Optional. Game id stored with every cloud save (default: pixel-coin-pusher).
VITE_GAME_ID=pixel-coin-pusher
# Optional. Comma separated list of OAuth providers you enabled in Supabase, shown only if Supabase itself also reports them as enabled.
# Supported by the UI: google, discord, github, apple. Leave empty to auto-detect from Supabase.
VITE_AUTH_PROVIDERS=
# Optional. Set to 1 only if "Manual linking" is enabled in the Supabase Auth settings (shows "Link provider" buttons).
VITE_ENABLE_LINKING=
# Optional. Exact origins (comma separated, no wildcard) of an embedding host that cooperates in opening the OAuth page. See docs/account-system.md.
VITE_TRUSTED_HOST_ORIGINS=
